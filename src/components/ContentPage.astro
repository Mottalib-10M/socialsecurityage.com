---
/**
 * Renders one page of `src/content/pages/`. Order (RECETTE §9.3, §21, §26): H1 and lead line; tool page:
 * the folded citable block, then the tool; guide: the citable block, then its mini-calculator, then the
 * body. FAQ, related pages, sources and publisher box come from PageLayout; the FAQ shown and the FAQ
 * declared in JSON-LD come from the same list (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import RecordCalculator from './calc/RecordCalculator';
import ClaimingTool from './calc/ClaimingTool';
import FraTool from './calc/FraTool';
import SpousalTool from './calc/SpousalTool';
import SurvivorTool from './calc/SurvivorTool';
import TaxTool from './calc/TaxTool';
import EarningsTool from './calc/EarningsTool';
import { route, ROUTES } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/pages';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/page-types';
interface Props { page: PageDef }
const { page } = Astro.props;
const lang = 'en' as const;
const x = page.en;
const ui = t(lang);
const path = route(page.id, lang);
const parts = x.body(helpers()).split(/<!--mini:([A-Za-z0-9_]+)-->/);
// Folded page: every chunk between two mini-calculators is cut at its <h2>; each section becomes a closed <details>.
const sectionsOf = (html: string) => html.split(/(?=<h2[\s>])/).map((seg) => { const m = seg.match(/^<h2[^>]*>([\s\S]*?)<\/h2>([\s\S]*)$/); return m ? { title: m[1], html: m[2] } : { title: null as string | null, html: seg }; }).filter((x) => x.title !== null || x.html.trim());
const jsonLd = [articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: x.h1, description: x.description, path, lang }));
if (x.faqs.length) jsonLd.push(faqSchema(x.faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.en.card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label.en, url: P.sources[k].url }));
const methodHref = route('method', lang);
const miniHref = page.miniHref && ROUTES.some((r) => r.id === page.miniHref) ? route(page.miniHref, lang) : route('home', lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
      <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
      <p class="mt-3 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">How we calculate</a></p>
    </header>
    {page.tool ? (
      <>
        <Clamp text={x.resume} lang={lang} id={`clamp-${page.id}`} class="mb-6" />
        <div data-outil>
          {page.tool === 'record' && <RecordCalculator client:load methodHref={methodHref} />}
          {page.tool === 'claiming' && <ClaimingTool client:load />}
          {page.tool === 'fra' && <FraTool client:load />}
          {page.tool === 'spouse' && <SpousalTool client:load />}
          {page.tool === 'survivor' && <SurvivorTool client:load />}
          {page.tool === 'tax' && <TaxTool client:load />}
          {page.tool === 'earnings' && <EarningsTool client:load />}
        </div>
      </>
    ) : page.fold ? (
      <>
        <Clamp text={x.resume} lang={lang} id={`clamp-${page.id}`} class="mb-6" />
        {page.mini && <MiniSim client:load kind={page.mini} lang={lang} href={miniHref} />}
      </>
    ) : (
      <>
        <p class="mb-6 text-navy-800">{x.resume}</p>
        {page.mini && <MiniSim client:load kind={page.mini} lang={lang} href={miniHref} />}
      </>
    )}
    {page.fold ? (
      <div class="fold-body mt-8">
        {parts.map((p, i) => i % 2 === 1 ? <MiniSim client:load kind={p} lang={lang} href={miniHref} /> : sectionsOf(p).map((sec) => sec.title === null
          ? <div class="prose prose-slate max-w-none" set:html={sec.html} />
          : <details class="fold-sec"><summary><h2 set:html={sec.title} /></summary><div class="prose prose-slate max-w-none" set:html={sec.html} /></details>))}
      </div>
    ) : (
      <div class="prose prose-slate max-w-none">
        {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={miniHref} />)}
      </div>
    )}
  </article>
</PageLayout>
