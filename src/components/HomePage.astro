---
/**
 * Home: calculator first, then the 2026 figures it uses, the birth-year table, the salary table,
 * the situations that change the math, the explanation, FAQ and sources (RECETTE §5, adapted).
 * Text in src/content/home.ts; tables computed by the engine at build time.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Estimator from './calc/Estimator';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, ROUTES } from '../i18n/routes';
import { helpers } from '../lib/helpers';
import { PAGES } from '../lib/pages';
import { P, bendPoints, type SourceKey } from '../lib/engine/params';
import { fraRetirement, fraSurvivor, workerReduction, computePia, projectCareer, benefitAtAge } from '../lib/engine/ss';
import { formatMoney, displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED } from '../data/site-config';
const lang = 'en' as const;
const h = helpers();
const x = HOME;
const path = route('home', lang);
const $ = (n: number, d = 0) => formatMoney(n, d);
const has = (id: string) => ROUTES.some((r) => r.id === id);
const keys: SourceKey[] = ['frNotice2026', 'ssaAwi', 'ssaBendPoints', 'ssaCbb', 'ssaColaSeries', 'ssaRetireExample', 'ssaMaxExample', 'cfr404_211', 'cfr404_212', 'cfr404_409', 'cfr404_410', 'cfr404_313', 'irsP915', 'pl118_273'];
const sources = keys.map((k) => ({ name: P.sources[k].label.en, url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: 'Social Security benefit calculator', description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const bp = bendPoints(2026);
const figures: Array<[string, string, SourceKey]> = [
  ['Cost-of-living adjustment (paid from January 2026)', `${P.cola_2026.pct}%`, 'frNotice2026'],
  ['National average wage index, 2024', P.series.awi['2024'].toLocaleString('en-US', { minimumFractionDigits: 2 }), 'ssaAwi'],
  ['PIA bend points, people turning 62 in 2026', `${$(bp[0])} and ${$(bp[1])}`, 'ssaBendPoints'],
  ['Maximum taxable earnings', $(P.taxable_max_2026), 'ssaCbb'],
  ['Earnings for one credit (four a year at most)', $(P.credits.qc_amount), 'frNotice2026'],
  ['Earnings test, under full retirement age all year', `${$(P.earnings_test.lower_annual)} a year`, 'frNotice2026'],
  ['Earnings test, year you reach full retirement age', `${$(P.earnings_test.higher_annual)} a year`, 'frNotice2026'],
  ['Medicare Part B standard premium', `${$(P.medicare.part_b_2026, 2)} a month`, 'cmsPartB'],
  ['Maximum benefit at 70 (steady maximum earnings)', `${$(P.max_benefit_2026.age70)} a month`, 'ssaMaxExample'],
];
const years = [1955, 1956, 1957, 1958, 1959, 1960, 1961, 1962, 1963, 1964];
const yearRows = years.map((y) => { const f = fraRetirement(y); const id = `born-${y}`; return { y, id, fra: f.months ? `${f.years} and ${f.months} months` : String(f.years), at62: 1 - workerReduction(f.total - 62 * 12), formula: Math.min(y + 62, 2026), sv: fraSurvivor(y) }; });
const salaries = [20000, 35000, 50000, 75000, 100000, 150000];
const salRows = salaries.map((s) => { const b = { y: 1964, m: 6, d: 15 }; const r = computePia(b, projectCareer(b, s, 22, 62)); return { s, id: `salary-${s}`, aime: r.aime, pia: r.pia, a62: benefitAtAge(r.pia, 62 * 12 + 1, 67 * 12).benefit, a70: benefitAtAge(r.pia, 840, 67 * 12).benefit }; });
const cases = PAGES.filter((p) => p.group === 'family' || p.group === 'taxwork');
const around = PAGES.filter((p) => p.group === 'retirement');
const parts = x.body(h).split(/<!--mini:([A-Za-z0-9_]+)-->/);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-5">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
    <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-navy-700"><span>2026 parameters, checked <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, 'en-US')}</time></span><a class="underline" href={route('method', lang)}>How we calculate</a><a class="underline" href={route('about', lang)}>Who publishes this site</a></p>
  </header>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="mb-6" />
  <Estimator client:load methodHref={route('method', lang)} />

  <section class="mt-12" aria-labelledby="figures">
    <h2 id="figures" class="text-2xl font-bold text-navy-900">The 2026 figures behind every result</h2>
    <p class="mt-2 text-navy-700">Read on the official sources on <time datetime={P.retrieved_at}>{displayDate(P.retrieved_at, 'en-US')}</time>, stored once in the site's parameter file and used by every page.</p>
    <div class="mt-4 overflow-x-auto"><table class="w-full text-sm">
      <thead><tr class="border-b border-navy-300 text-left text-xs uppercase tracking-wide text-navy-700"><th scope="col" class="py-2 pr-3">Parameter</th><th scope="col" class="py-2 pr-3 text-right">2026 value</th><th scope="col" class="py-2">Source</th></tr></thead>
      <tbody>{figures.map(([l, v, k]) => <tr class="border-b border-navy-100"><td class="py-2 pr-3 text-navy-800">{l}</td><td class="tabular-nums py-2 pr-3 text-right font-medium text-navy-900">{v}</td><td class="py-2"><a class="text-accent-700 underline" href={P.sources[k].url} target="_blank" rel="nofollow noopener noreferrer">{k === 'cmsPartB' ? 'CMS' : k === 'frNotice2026' ? '90 FR 49047' : 'SSA actuaries'}</a></td></tr>)}</tbody>
    </table></div>
  </section>

  <section class="mt-12" aria-labelledby="by-year">
    <h2 id="by-year" class="text-2xl font-bold text-navy-900">Your birth year: full retirement age and formula year</h2>
    <p class="mt-2 text-navy-700">The year you were born sets three things at once: your full retirement age, the share of the PIA you keep at 62, and the year whose formula applies to you.</p>
    <div class="mt-4 overflow-x-auto"><table class="w-full text-sm">
      <thead><tr class="border-b border-navy-300 text-left text-xs uppercase tracking-wide text-navy-700"><th scope="col" class="py-2 pr-3">Born in</th><th scope="col" class="py-2 pr-3">Full retirement age</th><th scope="col" class="py-2 pr-3 text-right">Kept at 62</th><th scope="col" class="py-2 pr-3 text-right">Formula year</th><th scope="col" class="py-2 text-right">Survivor FRA</th></tr></thead>
      <tbody class="tabular-nums">{yearRows.map((r) => <tr class="border-b border-navy-100"><td class="py-2 pr-3">{has(r.id) ? <a class="text-accent-700 underline" href={route(r.id, lang)}>{r.y}</a> : r.y}</td><td class="py-2 pr-3">{r.fra}</td><td class="py-2 pr-3 text-right">{h.pct(r.at62, 2)}</td><td class="py-2 pr-3 text-right">{r.formula}</td><td class="py-2 text-right">{r.sv.months ? `${r.sv.years} and ${r.sv.months} mo` : r.sv.years}</td></tr>)}
        <tr class="border-b border-navy-100"><td class="py-2 pr-3">{has('born-1965-later') ? <a class="text-accent-700 underline" href={route('born-1965-later', lang)}>1965 or later</a> : '1965 or later'}</td><td class="py-2 pr-3">67</td><td class="py-2 pr-3 text-right">{h.pct(1 - workerReduction(60), 2)}</td><td class="py-2 pr-3 text-right">2027 and later</td><td class="py-2 text-right">67</td></tr>
      </tbody>
    </table></div>
  </section>

  <section class="mt-12" aria-labelledby="by-salary">
    <h2 id="by-salary" class="text-2xl font-bold text-navy-900">What a salary turns into</h2>
    <p class="mt-2 text-navy-700">A worker born in 1964 who earned the equivalent of each salary in today's pay from 22 to 62, computed with the 2026 formula. Full retirement age 67.</p>
    <div class="mt-4 overflow-x-auto"><table class="w-full text-sm">
      <thead><tr class="border-b border-navy-300 text-left text-xs uppercase tracking-wide text-navy-700"><th scope="col" class="py-2 pr-3">Salary</th><th scope="col" class="py-2 pr-3 text-right">AIME</th><th scope="col" class="py-2 pr-3 text-right">PIA at 67</th><th scope="col" class="py-2 pr-3 text-right">At 62</th><th scope="col" class="py-2 text-right">At 70</th></tr></thead>
      <tbody class="tabular-nums">{salRows.map((r) => <tr class="border-b border-navy-100"><td class="py-2 pr-3">{has(r.id) ? <a class="text-accent-700 underline" href={route(r.id, lang)}>{$(r.s)}</a> : $(r.s)}</td><td class="py-2 pr-3 text-right">{$(r.aime)}</td><td class="py-2 pr-3 text-right">{$(r.pia)}</td><td class="py-2 pr-3 text-right">{$(r.a62)}</td><td class="py-2 text-right">{$(r.a70)}</td></tr>)}</tbody>
    </table></div>
  </section>

  {cases.length > 0 && (
    <section class="mt-12" aria-labelledby="cases">
      <h2 id="cases" class="text-2xl font-bold text-navy-900">Situations that change the math</h2>
      <ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2">{cases.map((p) => <li class="border-l-2 border-accent-300 pl-3"><a class="font-semibold text-accent-700 underline" href={route(p.id, lang)}>{p.en.nav}</a><span class="block text-sm text-navy-700">{p.en.card}</span></li>)}</ul>
    </section>
  )}

  {around.length > 0 && (
    <section class="mt-12" aria-labelledby="around">
      <h2 id="around" class="text-2xl font-bold text-navy-900">Medicare, IRAs and health cover around retirement</h2>
      <p class="mt-2 text-navy-700">The check is only part of the budget. These calculators handle what usually arrives in the same years: Medicare surcharges, required withdrawals, conversions, the HSA and the gap before 65.</p>
      <ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2">{around.map((p) => <li class="border-l-2 border-accent-300 pl-3"><a class="font-semibold text-accent-700 underline" href={route(p.id, lang)}>{p.en.nav}</a><span class="block text-sm text-navy-700">{p.en.card}</span></li>)}</ul>
    </section>
  )}

  <div class="prose prose-slate mt-12 max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : null)}
  </div>
</PageLayout>
