---
/** Embeddable page (iframe): the calculator alone, no navigation. noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import Estimator from '../../components/calc/Estimator';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Social Security benefit calculator (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Estimator client:load compact={true} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · computed in your browser, 2026 SSA parameters</p>
  </body>
</html>
