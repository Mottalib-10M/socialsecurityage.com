---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/social-security-estimator/" title="Social Security benefit calculator 2026" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Social Security benefit calculator on your website" description="Put the 2026 Social Security benefit calculator on your own site for free: one iframe to copy, PIA shown step by step, no sign-up, no tracking, all math done in the browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the Social Security calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One snippet, no account, no fee. Libraries, senior centers, credit unions, HR teams and financial-literacy programs use it to let people see how a benefit is computed.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the credit link under the calculator visible, do not alter the widget, and accept it as provided, without warranty. The 2026 parameters are updated here, so your embed follows each new COLA and wage index with no work on your side.</p>
    <p>No data about your visitors reaches us: the calculation runs in their browser and the iframe sets no cookie. Questions: see the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/social-security-estimator/" title="Social Security benefit calculator 2026" width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
